# macOS
.DS_Store

# Python
*.pyc
__pycache__/
.venv/
.pytest_cache/

# RAPTOR startup
.startup-output

# RAPTOR outputs
out/
.out/

# Local
.env*
.claude/*.local.json
.claude/raptor.env

# Runtime artifacts
codeql_dbs/

# SAGE (opt-in; generated by libexec/raptor-sage-setup)
.mcp.json
.sage/
*.sage.key


# APM dependencies
apm_modules/

# Temporary corpus/fetch working dirs
tmp_*/
*.log

# External binary stubs (installed separately) — machine-specific WSL/local-path
# shims and vendored downloads, never committed.
bin/afl-fuzz
bin/nuclei
bin/rr
bin/gdb
bin/gdb.cmd
bin/afl-fuzz.cmd
bin/rr.cmd
bin/codeql.cmd
bin/nuclei.exe

# Vendored tool archives fetched locally (nuclei/codeql zips, hundreds of MB)
vendor/

# Local backup of the project ledger
claude-projects.json.bak

# Generated corpus data (large, built locally)
.claude/skills/corpus/

# Claude Code auto-generated agent/skill files
.claude/agents/
.github/agents/
.github/skills/

# Node deps for ccr (claude-auto.mjs) — node-pty native, do not commit
node_modules/

# Work-graph store (SQLite/WAL) — the DB is regenerable from claude-projects.json;
# the git-tracked audit trail is the exported worklog-events.jsonl, not the .db.
raptor-worklog.db
raptor-worklog.db-wal
raptor-worklog.db-shm
