#!/usr/bin/env bash
# rp — RAPTOR lightweight project picker (replaces ccr; no PTY, no /effort injection)
# Bash wrapper (Git Bash / WSL): delegates to the PowerShell picker.
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
exec powershell -NoProfile -ExecutionPolicy Bypass -File "$(cygpath -w "$SCRIPT_DIR/rp.ps1" 2>/dev/null || echo "$SCRIPT_DIR/rp.ps1")" "$@"
