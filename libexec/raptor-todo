#!/usr/bin/env python3
"""raptor-todo — セッション横断 ToDo マネージャー

.claude-todo.json をプロジェクトディレクトリに作成・管理します。
制限リセット後の自動再開でも継続できるよう永続化されます。

Usage:
  raptor-todo add "タイトル"              新規タスクを追加
  raptor-todo done <id>                  完了としてマーク
  raptor-todo workaround <id> "メモ"     代替対応としてマーク（理由付き）
  raptor-todo in-progress <id>           作業中にマーク
  raptor-todo list                       全タスク表示
  raptor-todo pending                    未完了タスクのみ表示
  raptor-todo clear                      完了/代替済みタスクを削除
"""
import json
import os
import sys
import time
from pathlib import Path

TODO_FILE = Path(os.environ.get("CLAUDE_PROJECT_DIR", ".")) / ".claude-todo.json"

STATUS_ICON = {
    "pending":     "[ ]",
    "in_progress": "[>]",
    "done":        "[x]",
    "workaround":  "[~]",
}


def _load() -> dict:
    if TODO_FILE.exists():
        try:
            return json.loads(TODO_FILE.read_text("utf-8"))
        except Exception:
            pass
    return {"tasks": [], "next_id": 1}


def _save(data: dict) -> None:
    data["updated_at"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    TODO_FILE.write_text(json.dumps(data, indent=2, ensure_ascii=False), encoding="utf-8")


def _find(data: dict, id_str: str) -> dict | None:
    for t in data["tasks"]:
        if str(t["id"]) == id_str:
            return t
    return None


def cmd_add(title: str) -> int:
    data = _load()
    task = {
        "id": data.get("next_id", 1),
        "title": title,
        "status": "pending",
        "created_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
    }
    data.setdefault("tasks", []).append(task)
    data["next_id"] = task["id"] + 1
    _save(data)
    print(f"[todo] Added #{task['id']}: {title}")
    return 0


def cmd_done(id_str: str) -> int:
    data = _load()
    t = _find(data, id_str)
    if not t:
        print(f"[todo] #{id_str} not found", file=sys.stderr)
        return 1
    t["status"] = "done"
    t["completed_at"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    _save(data)
    print(f"[todo] Done    #{t['id']}: {t['title']}")
    return 0


def cmd_workaround(id_str: str, note: str) -> int:
    data = _load()
    t = _find(data, id_str)
    if not t:
        print(f"[todo] #{id_str} not found", file=sys.stderr)
        return 1
    t["status"] = "workaround"
    t["note"] = note
    t["completed_at"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    _save(data)
    print(f"[todo] Workaround #{t['id']}: {t['title']}")
    print(f"         note: {note}")
    return 0


def cmd_in_progress(id_str: str) -> int:
    data = _load()
    t = _find(data, id_str)
    if not t:
        print(f"[todo] #{id_str} not found", file=sys.stderr)
        return 1
    t["status"] = "in_progress"
    _save(data)
    print(f"[todo] In Progress #{t['id']}: {t['title']}")
    return 0


def cmd_list(filter_status: str | None = None) -> int:
    data = _load()
    tasks = data.get("tasks", [])
    if filter_status:
        tasks = [t for t in tasks if t["status"] == filter_status]
    if not tasks:
        print("[todo] No tasks")
        return 0
    for t in tasks:
        icon = STATUS_ICON.get(t["status"], "[?]")
        note = f"  -> {t['note']}" if t.get("note") else ""
        print(f"  {icon} #{t['id']} {t['title']}{note}")
    return 0


def cmd_clear() -> int:
    data = _load()
    before = len(data.get("tasks", []))
    data["tasks"] = [t for t in data.get("tasks", []) if t["status"] in ("pending", "in_progress")]
    after = len(data["tasks"])
    _save(data)
    print(f"[todo] Removed {before - after} completed/workaround tasks")
    return 0


def main() -> int:
    if len(sys.argv) < 2:
        print(__doc__)
        return 0
    cmd = sys.argv[1]
    if cmd == "add" and len(sys.argv) >= 3:
        return cmd_add(" ".join(sys.argv[2:]))
    if cmd == "done" and len(sys.argv) >= 3:
        return cmd_done(sys.argv[2])
    if cmd in ("workaround", "wa") and len(sys.argv) >= 4:
        return cmd_workaround(sys.argv[2], " ".join(sys.argv[3:]))
    if cmd in ("in-progress", "wip") and len(sys.argv) >= 3:
        return cmd_in_progress(sys.argv[2])
    if cmd == "list":
        return cmd_list()
    if cmd == "pending":
        return cmd_list("pending")
    if cmd == "clear":
        return cmd_clear()
    print(__doc__)
    return 1


if __name__ == "__main__":
    sys.exit(main())
