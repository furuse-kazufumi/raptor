#!/usr/bin/env python3
"""
Stop フック: transcript 行数でコンテキスト使用量を推定し WARN/CRITICAL を通知する。

出力規則（Claude Code の Stop フックで UI に表示される）:
  [ROTATE:WARN]     n msgs  → 警告。ユーザーが任意で /rotate を実行。
  [ROTATE:CRITICAL] n msgs  → 臨界。CLAUDE.md の指示に従い Claude が自動 /rotate。

出力なし                    → 正常範囲。何もしない。
"""
import io
import os
import sys
from pathlib import Path

# Windows 環境での文字化け防止
if hasattr(sys.stdout, "reconfigure"):
    sys.stdout.reconfigure(encoding="utf-8")

# ─── 閾値（JSONL 行数 = メッセージターン数の近似） ───────────────
WARN_LINES     = 150   # ~70% 相当
CRITICAL_LINES = 250   # ~90% 相当


def find_transcript() -> Path | None:
    """現在のセッション transcript を探す。"""
    env_path = os.environ.get("CLAUDE_TRANSCRIPT_PATH")
    if env_path and Path(env_path).exists():
        return Path(env_path)

    # フォールバック: ~/.claude/projects/ 以下の最新 JSONL
    projects_dir = Path.home() / ".claude" / "projects"
    if not projects_dir.exists():
        return None
    files = list(projects_dir.rglob("*.jsonl"))
    return max(files, key=lambda p: p.stat().st_mtime) if files else None


def count_lines(p: Path) -> int:
    try:
        with p.open(encoding="utf-8", errors="ignore") as f:
            return sum(1 for _ in f)
    except OSError:
        return 0


def main() -> None:
    t = find_transcript()
    if not t:
        return

    n = count_lines(t)

    if n >= CRITICAL_LINES:
        print(
            f"[ROTATE:CRITICAL] コンテキスト使用量が臨界水準です（推定 {n} メッセージ）。"
            f" /rotate を今すぐ実行してください。",
            flush=True,
        )
    elif n >= WARN_LINES:
        print(
            f"[ROTATE:WARN] コンテキスト使用量が増加中（推定 {n} メッセージ）。"
            f" 近いうちに /rotate を推奨します。",
            flush=True,
        )
    # 正常範囲は出力なし


if __name__ == "__main__":
    main()
