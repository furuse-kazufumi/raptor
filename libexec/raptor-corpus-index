#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
"""Generate flat INDEX.md for the raptor corpus skill hierarchy.

The corpus2skill pipeline emits a deep tree of SKILL.md files under
`.claude/skills/corpus/<source>/cluster_NN/.../SKILL.md` (4000+ files).
This script writes a single flat `.claude/skills/corpus/INDEX.md` that
lets a human or Claude locate the right corpus skill without descending
through every cluster.

Run from the raptor repo root:

    python3 libexec/raptor-corpus-index
    # or after raptor.py launcher sets cwd:
    libexec/raptor-corpus-index
"""

from __future__ import annotations

import sys
from pathlib import Path


ROOT = Path(".claude/skills/corpus")


def _read_description(skill_md: Path) -> str:
    """Pull the `description:` frontmatter field from a SKILL.md (first line)."""
    if not skill_md.exists():
        return "(no SKILL.md)"
    try:
        content = skill_md.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return "(unreadable)"
    in_fm = False
    for line in content.splitlines():
        if line.strip() == "---":
            in_fm = not in_fm
            continue
        if in_fm and line.startswith("description:"):
            desc = line.split(":", 1)[1].strip()
            # description may be a YAML scalar or a folded block; take first line
            if desc.startswith("|") or desc.startswith(">"):
                # Look at the next non-empty line
                continue
            return desc[:120]
    # Try the first non-empty paragraph after frontmatter
    for para in content.split("\n\n"):
        para = para.strip()
        if para and not para.startswith("#") and "---" not in para[:5]:
            return para.splitlines()[0][:120]
    return "(no description)"


def main() -> int:
    if not ROOT.exists():
        print(f"corpus dir not found: {ROOT}", file=sys.stderr)
        return 1

    sources = sorted([d for d in ROOT.iterdir() if d.is_dir()])
    total_skill_md = sum(1 for _ in ROOT.rglob("SKILL.md"))

    lines: list[str] = [
        "# Corpus Skill Index",
        "",
        f"Auto-generated by `libexec/raptor-corpus-index`.",
        f"**{len(sources)}** corpus sources, **{total_skill_md}** total SKILL.md files.",
        "",
        "To explore a corpus, open the source's top-level SKILL.md or descend into",
        "the cluster directory matching your domain.",
        "",
        "## Sources overview",
        "",
        "| Source | Clusters | Total SKILL.md | Description |",
        "|---|---|---|---|",
    ]

    for src in sources:
        clusters = [c for c in src.iterdir() if c.is_dir() and c.name.startswith("cluster_")]
        skill_count = sum(1 for _ in src.rglob("SKILL.md"))
        top_skill = src / "SKILL.md"
        desc = _read_description(top_skill).replace("|", "\\|")
        lines.append(
            f"| `{src.name}` | {len(clusters)} | {skill_count} | {desc} |"
        )

    lines.extend(["", "## Cluster index (per source)", ""])

    for src in sources:
        clusters = sorted(
            [c for c in src.iterdir() if c.is_dir() and c.name.startswith("cluster_")]
        )
        if not clusters:
            continue
        lines.append(f"### `{src.name}`")
        lines.append("")
        for c in clusters:
            desc = _read_description(c / "SKILL.md").replace("|", "\\|")
            sub_count = sum(1 for _ in c.rglob("SKILL.md"))
            lines.append(f"- **`{c.name}`** ({sub_count} SKILL.md) — {desc}")
        lines.append("")

    target = ROOT / "INDEX.md"
    target.write_text("\n".join(lines), encoding="utf-8")
    print(
        f"Wrote {target}: {len(sources)} sources, {total_skill_md} SKILL.md files"
    )
    return 0


if __name__ == "__main__":
    sys.exit(main())
