#!/usr/bin/env python3
"""SessionStart hook: env file setup and startup banner.

Called automatically by Claude Code on session start (via .claude/settings.json).
Writes RAPTOR_DIR + PATH to the env file (overwrite, not append) and generates
the startup banner in .startup-output.

No project env vars are set — the .active symlink is the only source of truth.
"""
import os
import subprocess
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(REPO_ROOT))


def write_env_file():
    """Merge RAPTOR_DIR + PATH into env file, preserving existing entries."""
    env_file = os.environ.get("CLAUDE_ENV_FILE")
    if not env_file:
        return

    repo_root = str(REPO_ROOT)
    bin_dir = str(REPO_ROOT / "bin")
    env_path = Path(env_file)

    # Read existing content to preserve user-defined vars (e.g. API keys)
    try:
        existing = env_path.read_text(encoding="utf-8") if env_path.exists() else ""
    except OSError:
        existing = ""

    additions = []
    if f'RAPTOR_DIR=' not in existing:
        additions.append(f'export RAPTOR_DIR="{repo_root}"')
    if bin_dir not in existing:
        additions.append(f'export PATH="$PATH:{bin_dir}"')

    if not additions:
        return

    try:
        with env_path.open("a", encoding="utf-8") as f:
            f.write("\n".join(additions) + "\n")
    except OSError:
        pass


def generate_banner():
    """Generate the startup banner and write to .startup-output."""
    try:
        from core.startup.init import main as init_main
        init_main()
    except Exception as e:
        # Non-fatal — write a minimal banner
        output_file = REPO_ROOT / ".startup-output"
        try:
            output_file.write_text(f"RAPTOR startup error: {e}\n", encoding='utf-8')
        except OSError:
            pass


def append_brain_recall():
    """Phase 1 of the brain dedup migration: auto-inject the second brain's
    project table into the startup banner.

    ``.startup-output`` is echoed verbatim at session start, so appending the
    brain's per-project recall table here surfaces cross-project progress every
    session without an explicit ``/brain`` invocation. We inject ONLY the
    Projects section (not the ~70-entry corpus catalog) to keep the token cost
    minimal; the corpus catalog stays on-demand via the ``brain`` skill.

    Fail-safe: if the generated brain skill is absent (never synced) or
    unreadable, do nothing. MEMORY.md remains the native auto-load until later
    phases trim the overlap, so a miss here never loses recall.
    """
    skill = Path.home() / ".claude" / "skills" / "brain" / "SKILL.md"
    if not skill.exists():
        return
    try:
        text = skill.read_text(encoding="utf-8")
    except OSError:
        return

    # Extract the "## Projects" section up to (not including) the next H2.
    lines = text.splitlines()
    start = next((i for i, ln in enumerate(lines) if ln.startswith("## Projects")), None)
    if start is None:
        return
    end = next((i for i in range(start + 1, len(lines)) if lines[i].startswith("## ")), len(lines))
    section = "\n".join(lines[start:end]).rstrip()
    if not section:
        return

    output_file = REPO_ROOT / ".startup-output"
    try:
        with output_file.open("a", encoding="utf-8") as f:
            f.write("\n\n--- brain recall (auto-injected · /brain for corpus) ---\n\n")
            f.write(section + "\n")
    except OSError:
        pass


def reap_orphan_mcp():
    """Fail-safe: reap MCP servers orphaned by prior ccr sessions.

    Frequent session rotation (e.g. the llterm loop) leaves stdio MCP servers
    (osv-mcp, ...) orphaned when the launcher exits; they accumulate across
    sessions. ``raptor-mcp-reaper`` kills only those with no live launcher
    ancestor (the current session's servers are untouched). Never blocks or
    breaks startup. Windows-only inside the reaper; a harmless no-op elsewhere.
    """
    try:
        subprocess.run(
            [sys.executable, str(REPO_ROOT / "libexec" / "raptor-mcp-reaper")],
            capture_output=True, timeout=35,
        )
    except Exception:
        pass


if __name__ == "__main__":
    write_env_file()
    generate_banner()
    append_brain_recall()
    reap_orphan_mcp()
