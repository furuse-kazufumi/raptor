#!/usr/bin/env python3
"""raptor-sca — SCA launcher with lifecycle management."""
import os
import subprocess
import sys
from pathlib import Path

RAPTOR_DIR = Path(__file__).resolve().parents[1]
os.environ.setdefault("RAPTOR_DIR", str(RAPTOR_DIR))

script = RAPTOR_DIR / "raptor_sca.py"
env = {**os.environ, "RAPTOR_DIR": str(RAPTOR_DIR)}

result = subprocess.run([sys.executable, str(script)] + sys.argv[1:], env=env)
sys.exit(result.returncode)
